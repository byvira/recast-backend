# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=SaaS Backend

# ENVIRONMENT: "development" | "production"
# development → OTP printed to console, CORS allows localhost, docs are public
# production  → OTP sent via Resend/Twilio, CORS restricted to PRODUCTION_DOMAIN
#               + ALLOWED_ORIGINS, docs gated behind DOCS_USERNAME/DOCS_PASSWORD
ENVIRONMENT=development

# ── Security ─────────────────────────────────────────────────────────────────
# Required. Generate a DIFFERENT value per environment:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-64-char-random-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── OTP / Auth limits ────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_SENDS_PER_DAY=10
OTP_COOLDOWN_SECONDS=60
OTP_LOCK_MINUTES=15
JWT_EXPIRE_HOURS=24
JWT_REFRESH_EXPIRE_DAYS=30
JWT_ISSUER=saas-backend
JWT_AUDIENCE=saas-api

# ── Email — Resend ────────────────────────────────────────────────────────────
# Resend rejects sends from unverified/free-mail domains (gmail.com etc) —
# verify a domain in Resend before setting EMAIL_FROM for production.
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@yourdomain.com

# ── SMS — Twilio ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# ── LLM provider ─────────────────────────────────────────────────────────────
# LLM_PROVIDER options: groq | gemini  (default: groq; gemini is the fallback)
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-key-here
GEMINI_API_KEY=your-gemini-key-here
# Groq's tokens-per-minute ceiling for this account/tier — bump after
# upgrading Groq's plan, no code change needed. See app/shared/llm.py.
GROQ_TPM_LIMIT=8000

# ── LangSmith tracing (agent observability) ───────────────────────────────────
# Set TRACING_V2=true + an API key to make every agent graph run inspectable
# in LangSmith. Leave unset locally if you don't want traces for every run.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__your_langsmith_key_here
LANGCHAIN_PROJECT=recast-agents
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Data stores ───────────────────────────────────────────────────────────────
# Required. Database name must be included in the URL for get_default_database().
MONGODB_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?appName=Recast
REDIS_URL=redis://default:<password>@<host>:<port>

# ── Storage — Cloudinary ──────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── CORS ──────────────────────────────────────────────────────────────────────
# Development: the full allowed-origins list.
# Production: merged with PRODUCTION_DOMAIN — use this for any *additional*
# prod origins (a staging frontend, a second domain).
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Production domain — REQUIRED when ENVIRONMENT=production.
# Must be the FRONTEND's origin (not this backend's own URL) — it feeds
# straight into the CORS allow-list.
# Example: https://app.yourdomain.com
PRODUCTION_DOMAIN=

# ── API docs gating ────────────────────────────────────────────────────────────
# /docs, /redoc, /scalar, /openapi.json require these in production via HTTP
# Basic auth. If either is unset, docs are unreachable in production (never
# open by accident). Not needed in development — docs are public there.
DOCS_USERNAME=
DOCS_PASSWORD=

# ── Logging & error tracking ──────────────────────────────────────────────────
# LOG_FORMAT: "console" (colored, human-readable) | "json" (one JSON object
# per line, for a log aggregator). Defaults to json in production, console
# in development — only set this to override that default.
LOG_FORMAT=
# Sentry DSN — blank means Sentry is never initialised. Create a free project
# at sentry.io (Python/FastAPI) to get one.
SENTRY_DSN=

# ── Alerts ────────────────────────────────────────────────────────────────────
# Slack incoming webhook + fallback email for publish-pipeline exhaustion and
# token-refresh failures. Blank = alerts silently no-op.
SLACK_WEBHOOK_URL=
ALERT_EMAIL=

# ── Token encryption ───────────────────────────────────────────────────────────
# Encrypts/decrypts OAuth access + refresh tokens stored in MongoDB.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this requires a re-encrypt migration of workspace_connections —
# see the ops runbook — otherwise every connected account has to reconnect.
FERNET_SECRET_KEY=

# ── OAuth — Meta (Instagram + Threads + Facebook) ─────────────────────────────
# One Meta app covers all three. Register at developers.facebook.com/apps.
# Local dev: use an ngrok URL as redirect URI (Meta blocks plain localhost).
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://YOUR-NGROK-URL.ngrok-free.app/api/v1/oauth/meta/callback
META_CONFIG_ID=

THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=

# ── OAuth — Google ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback

# ── OAuth — LinkedIn ───────────────────────────────────────────────────────────
# Register at developer.linkedin.com/apps. Scopes: w_member_social, r_basicprofile
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/oauth/linkedin/callback

# ── OAuth — Twitter / X ────────────────────────────────────────────────────────
# Register at developer.twitter.com/portal. Requires $100/mo Basic tier for
# write access (posting). Scopes: tweet.read, tweet.write, users.read
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_REDIRECT_URI=http://localhost:8000/api/v1/oauth/twitter/callback

# ── OAuth — Reddit ─────────────────────────────────────────────────────────────
# Register at reddit.com/prefs/apps → create web app. Scopes: submit, identity, read
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:8000/api/v1/oauth/reddit/callback
REDDIT_USER_AGENT=ViraStudio/1.0

# ── Bluesky ────────────────────────────────────────────────────────────────────
# No developer registration needed — AT Protocol auth. Users connect via
# their handle + an App Password (bsky.app → Settings → App Passwords).
BLUESKY_APP_NAME=recast
BLUESKY_SERVICE_URL=https://bsky.social
# Test-only app password for local/CI smoke tests — never a real user's.
BLUESKY_TEST_APP_PASSWORD=

# ── Publish pipeline ───────────────────────────────────────────────────────────
PUBLISH_MAX_RETRIES=3
PUBLISH_RETRY_BASE_DELAY=5
TOKEN_REFRESH_THRESHOLD_MINUTES=10080

# ── Free tier ─────────────────────────────────────────────────────────────────
FREE_CREDITS_LIMIT=100
